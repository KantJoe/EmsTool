<UserControl
    x:Class="org.Ui.Views.EditPointDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mconvt="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
    xmlns:selectors="clr-namespace:org.Ui.Selectors;assembly=org.Ui"
    xmlns:viewModels="clr-namespace:org.Ui.ViewModels"
    Width="480"
    Height="320"
    TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">
    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <TextBlock Text="Ems: " />
            <TextBlock Name="TxtEms" Text="COM99" />
        </StackPanel>
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <TextBlock Text="功能码: " />
            <TextBlock Name="TxtFunctionCode" Text="03" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <TextBlock Text="起始地址: " />
            <materialDesign:NumericUpDown
                Name="NumStartAddress"
                Width="60"
                IsEnabled="False"
                Maximum="7000"
                Minimum="0"
                Value="0" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <TextBlock VerticalAlignment="Center" Text="连续点数量: " />
            <materialDesign:NumericUpDown
                Name="NumCount"
                Width="60"
                Maximum="125"
                Minimum="1"
                Value="1" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <TextBlock VerticalAlignment="Center" Text="数据类型: " />
            <ComboBox
                Name="CbDataType"
                Width="120"
                SelectionChanged="CbDataType_SelectionChanged">
                <ComboBoxItem Content="ushort" IsSelected="True" />
                <ComboBoxItem Content="uint32" />
                <ComboBoxItem Content="int32" />
                <ComboBoxItem Content="ASCII" />
            </ComboBox>
        </StackPanel>
        <StackPanel
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock Foreground="Red" Text="双字节/4字节:[,]逗号隔开 / ASCII:输入完整字符串,并设定点数量" />
        </StackPanel>
        <TextBox
            Name="TxtValue"
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,5,0,5"
            AcceptsReturn="False" />
        <Button
            Grid.Row="5"
            Grid.Column="0"
            Width="80"
            Margin="0,0,20,0"
            HorizontalAlignment="Right"
            Click="Button_Click"
            Content="{Binding 确定, Source={x:Static lang:MultiLang.Instance}}" />
        <Button
            Grid.Row="5"
            Grid.Column="1"
            Width="80"
            Margin="20,0,0,0"
            HorizontalAlignment="Left"
            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
            CommandParameter="Sample2Cancel"
            Content="{Binding 取消, Source={x:Static lang:MultiLang.Instance}}"
            IsCancel="True" />
    </Grid>
</UserControl>
