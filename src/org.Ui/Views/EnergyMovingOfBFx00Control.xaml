<UserControl
    x:Class="org.Ui.Views.EnergyMovingOfBFx00Control"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:Figures="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage"
    xmlns:local="clr-namespace:org.Ui.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:valid="clr-namespace:org.Ui.ValidationRules"
    Width="860"
    Height="700">
    <materialDesign:Card Margin="0,10,0,0" materialDesign:ElevationAssist.Elevation="Dp16">
        <Canvas>
            <Image
                Canvas.Left="70"
                Canvas.Top="140"
                Height="400"
                Source="/Resources/Images/BF100.png" />
            <Grid Canvas.Left="440" Canvas.Top="200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40*" />
                    <ColumnDefinition Width="60*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{Binding 型号, Source={x:Static lang:MultiLang.Instance}, FallbackValue=型号:}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{Binding FirstDeviceModel.ModelName}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{Binding 设备拓扑_标称容量, Source={x:Static lang:MultiLang.Instance}, FallbackValue=标称容量:}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{Binding FirstDeviceModel.Soc}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{Binding 设备拓扑_实时充电电流, Source={x:Static lang:MultiLang.Instance}, FallbackValue=标称容量:}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{Binding ChargingCurrent}" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{Binding 设备拓扑_实时放电电流, Source={x:Static lang:MultiLang.Instance}, FallbackValue=标称容量:}" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{Binding DisChargingCurrent}" />
            </Grid>

        </Canvas>
    </materialDesign:Card>
</UserControl>
