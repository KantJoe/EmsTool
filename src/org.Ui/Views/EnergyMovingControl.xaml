<UserControl
    x:Class="org.Ui.Views.EnergyMovingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:Figures="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage"
    xmlns:local="clr-namespace:org.Ui.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:valid="clr-namespace:org.Ui.ValidationRules"
    Width="860"
    Height="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/org.Ui;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="/org.Ui;component/Themes/Energies.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ScaleTransform x:Key="ScaleXY" ScaleX="0.5" ScaleY="0.5" />
            <Style x:Key="LineBackgroud" TargetType="{x:Type Polyline}">
                <Setter Property="Stroke" Value="{StaticResource MaterialDesign.Brush.Background}" />
                <Setter Property="StrokeThickness" Value="2" />
            </Style>
            <Style x:Key="LineForcegroud" TargetType="{x:Type Polyline}">
                <Setter Property="Stroke" Value="{StaticResource MaterialDesign.Brush.Primary}" />
                <Setter Property="StrokeThickness" Value="5" />
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp16" />
                <Setter Property="StrokeDashArray" Value="2 900" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <materialDesign:Card Margin="0,10,0,0" materialDesign:ElevationAssist.Elevation="Dp16">
        <Canvas>
            <!--  左侧起始0+75，顶部起始0+25  -->
            <ProgressBar
                Canvas.Left="390"
                Canvas.Top="140"
                IsIndeterminate="True"
                Style="{StaticResource MaterialDesignCircularProgressBar}"
                Visibility="Collapsed"
                Value="35">
                <!--  实际是left=375-425中间-(20/2),top= 125-175中间-(20/2)  -->
            </ProgressBar>


            <Path
                Canvas.Left="725"
                Canvas.Top="25"
                Stroke="White"
                Style="{StaticResource PowerGrid}"
                Visibility="Collapsed" />
            <Polyline
                Points="410 145 675 145 675 50 700 50"
                Style="{StaticResource LineBackgroud}"
                Visibility="Collapsed" />
            <Polyline
                Points="410 145 675 145 675 50 700 50"
                Style="{StaticResource LineForcegroud}"
                Visibility="Collapsed">
                <Polyline.Triggers>
                    <EventTrigger RoutedEvent="Polyline.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" Storyboard.TargetProperty="StrokeDashOffset">
                                <DoubleAnimation
                                    From="0"
                                    To="-200"
                                    Duration="0:0:3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Polyline.Triggers>
            </Polyline>

            <Path
                Canvas.Left="300"
                Canvas.Top="175"
                Stroke="White"
                Style="{StaticResource Pcs}" />
            <Polyline Points="395 160 395 200 350 200" Style="{StaticResource LineBackgroud}" />
            <Polyline Points="395 160 395 200 350 200" Style="{StaticResource LineForcegroud}">
                <Polyline.Triggers>
                    <EventTrigger RoutedEvent="Polyline.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" Storyboard.TargetProperty="StrokeDashOffset">
                                <DoubleAnimation
                                    From="0"
                                    To="-200"
                                    Duration="0:0:3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Polyline.Triggers>
            </Polyline>

            <Path
                Canvas.Left="300"
                Canvas.Top="275"
                Stroke="White"
                Style="{StaticResource Battery}" />
            <Polyline Points="325 225 325 275" Style="{StaticResource LineBackgroud}" />
            <Polyline Points="325 225 325 275" Style="{StaticResource LineForcegroud}">
                <Polyline.Triggers>
                    <EventTrigger RoutedEvent="Polyline.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" Storyboard.TargetProperty="StrokeDashOffset">
                                <DoubleAnimation
                                    From="0"
                                    To="-200"
                                    Duration="0:0:3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Polyline.Triggers>
            </Polyline>

        </Canvas>
    </materialDesign:Card>
</UserControl>
