<UserControl
    x:Class="org.Ui.Poseidon.Views.PointMapBusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mconvt="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
    xmlns:selectors="clr-namespace:org.Ui.Selectors;assembly=org.Ui"
    xmlns:viewModels="clr-namespace:org.Ui.Poseidon.ViewModels"
    d:DesignHeight="758"
    d:DesignWidth="1238"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <DockPanel
            Grid.Row="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center" Text="指定Ems: " />
            <ComboBox
                Name="CbLinks"
                Width="180"
                ItemsSource="{Binding Links}"
                SelectedItem="{Binding SelectedLink}" />
            <TextBlock
                Margin="40,0,0,0"
                VerticalAlignment="Center"
                Text="分组: " />
            <ComboBox
                Name="CbGroup"
                Width="210"
                DisplayMemberPath="Display"
                ItemsSource="{Binding Mappings}"
                SelectedItem="{Binding SelectedMapping}" />
            <Button
                Name="BtnRefresh"
                Width="80"
                Margin="100,0,0,0"
                Click="BtnRefresh_Click"
                Content="刷新" />
            <Button
                Name="BtnStop"
                Width="80"
                Margin="50,0,0,0"
                Background="Red"
                BorderThickness="0"
                Command="{Binding StopCommand, IsAsync=True}"
                Content="停止"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </DockPanel>
        <ListView
            Grid.Row="2"
            ItemsSource="{Binding Points}"
            SelectedItem="{Binding SelectedPoint}"
            VirtualizingPanel.CacheLength="125"
            VirtualizingPanel.CacheLengthUnit="Item"
            VirtualizingPanel.IsContainerVirtualizable="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Item"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn DisplayMemberBinding="{Binding AddressStr}" Header="Address" />
                    <GridViewColumn DisplayMemberBinding="{Binding CurrentValue}" Header="CurrentValue" />
                    <GridViewColumn DisplayMemberBinding="{Binding UpdateDateTime}" Header="UpdateDateTime" />
                    <GridViewColumn Width="320" Header="Options">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Command="{Binding DataContext.EditPointCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}, IsAsync=True}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding 下发, Source={x:Static lang:MultiLang.Instance}}"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button
                                        Command="{Binding DataContext.AddAlertCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}, IsAsync=True}"
                                        CommandParameter="{Binding}"
                                        Content="添加告警"
                                        Style="{StaticResource MaterialDesignFlatSecondaryButton}" />
                                    <Button
                                        Command="{Binding DataContext.AddLivingMoniterCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}, IsAsync=True}"
                                        CommandParameter="{Binding}"
                                        Content="添加实时监控"
                                        Style="{StaticResource MaterialDesignFlatSecondaryButton}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
