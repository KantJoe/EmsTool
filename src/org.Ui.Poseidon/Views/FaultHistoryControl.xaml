<UserControl
    x:Class="org.Ui.Poseidon.Views.FaultHistoryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:convt="clr-namespace:org.Ui.Converters;assembly=org.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="clr-namespace:org.Ui.Selectors;assembly=org.Ui"
    xmlns:viewModels="clr-namespace:org.Ui.Poseidon.ViewModels"
    d:DesignHeight="758"
    d:DesignWidth="1248"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">
    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock
                Width="120"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="{Binding 指定EMS, Source={x:Static lang:MultiLang.Instance}, FallbackValue=指定EMS}" />
            <ComboBox
                Width="180"
                ItemsSource="{Binding Links}"
                SelectedItem="{Binding SelectedLink}">
                <Behaviors:Interaction.Triggers>
                    <Behaviors:EventTrigger EventName="SelectionChanged">
                        <Behaviors:InvokeCommandAction Command="{Binding SelectLinkChangedCommand}" />
                    </Behaviors:EventTrigger>
                </Behaviors:Interaction.Triggers>
            </ComboBox>
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Margin="0,0,20,0"
                Command="{Binding RefreshCommand, IsAsync=True}"
                Content="{Binding 刷新, Source={x:Static lang:MultiLang.Instance}, FallbackValue=刷新}" />
            <Button
                Margin="20,0,40,0"
                Command="{Binding SaveAsCommand, IsAsync=True}"
                Content="{Binding 另存为, Source={x:Static lang:MultiLang.Instance}, FallbackValue=另存为}" />
        </StackPanel>
        <ListView
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            ItemsSource="{Binding FaultItems}"
            SelectedItem="{Binding SelectedItem}"
            VirtualizingPanel.CacheLength="30"
            VirtualizingPanel.CacheLengthUnit="Item"
            VirtualizingPanel.IsContainerVirtualizable="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Item"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="Background" Value="{Binding EventLevelBackground}" />
                    <Setter Property="Opacity" Value="0.6" />
                    <Setter Property="FontSize" Value="18" />
                    <Setter Property="Foreground" Value="Black" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn DisplayMemberBinding="{Binding No}" Header="No" />
                    <GridViewColumn DisplayMemberBinding="{Binding EventCode}" Header="EventCode" />
                    <GridViewColumn DisplayMemberBinding="{Binding EventLevelStr}" Header="EventLevelStr" />
                    <GridViewColumn
                        Width="210"
                        DisplayMemberBinding="{Binding TriggedDateTime}"
                        Header="TriggedDateTime" />
                    <GridViewColumn
                        Width="320"
                        DisplayMemberBinding="{Binding Content}"
                        Header="Content" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>

</UserControl>
