<UserControl
    x:Class="org.Ui.Poseidon.Views.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:org.Ui.Poseidon.ViewModels"
    d:DesignHeight="758"
    d:DesignWidth="1248"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical">
            <TabControl
                MinHeight="700"
                Style="{StaticResource MaterialDesignFilledTabControl}"
                TabStripPlacement="Left">
                <TabItem Header="{Binding 设置_交互, Source={x:Static lang:MultiLang.Instance}}">
                    <Grid Margin="10,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{Binding 设置_实时渲染间隔, Source={x:Static lang:MultiLang.Instance}}" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            MinWidth="40"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            Text="{Binding LivingRenderInterval}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="串口轮询延迟开关" />
                        <ToggleButton
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsChecked="{Binding ModbusPollingOptimizeSwitch, Converter={x:Static materialDesign:InvertBooleanConverter.Instance}}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="串口轮询延迟(毫秒)" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            MinWidth="40"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            Text="{Binding ModbusPollingOptimizeValue}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="实时监控最小轮询时长(ms)" />
                        <materialDesign:NumericUpDown
                            Grid.Row="3"
                            Grid.Column="1"
                            Width="80"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            Maximum="2000"
                            Minimum="10"
                            Value="{Binding LivingTracingMinimumInterval}" />
                    </Grid>
                </TabItem>
                <TabItem Header="{Binding 设置_工作区, Source={x:Static lang:MultiLang.Instance}}">
                    <Grid Margin="10,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{Binding 设置_Modbus轮询间隔, Source={x:Static lang:MultiLang.Instance}}" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="{Binding ModbusPollingInterval}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{Binding 设置_点位表分组长度, Source={x:Static lang:MultiLang.Instance}}" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="{Binding LengthOfPointMapGroup}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{Binding 设置_点位表, Source={x:Static lang:MultiLang.Instance}}" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="130"
                            HorizontalAlignment="Right"
                            Command="{Binding PointMapRangeGenerateCommand, IsAsync=True}"
                            Content="{Binding 自动生成, Source={x:Static lang:MultiLang.Instance}}" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="2"
                            Width="130"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding AppendPointRangeCommand, IsAsync=True}"
                            Content="手动追加" />
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="功能码" />
                            <TextBox Width="40" Text="{Binding ManualFunctionCode}" />
                            <TextBox Width="40" Text="{Binding ManualStartAddress}" />
                            <TextBlock Text="~" />
                            <TextBox Width="40" Text="{Binding ManualEndAddress}" />
                        </StackPanel>
                        <DataGrid
                            Grid.Row="3"
                            Grid.RowSpan="11"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="All"
                            ItemsSource="{Binding PointMapRang}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding SlaveId}" Header="SlaveId" />
                                <DataGridTextColumn Binding="{Binding FunctionCode}" Header="FunctionCode" />
                                <DataGridTextColumn Binding="{Binding GroupName}" Header="GroupName" />
                                <DataGridTextColumn Binding="{Binding MapLimitation}" Header="MapLimitation" />
                                <DataGridTextColumn Binding="{Binding StartAddress}" Header="StartAddress" />
                                <DataGridTextColumn Binding="{Binding PointCount}" Header="PointCount" />
                                <DataGridTemplateColumn Header="{Binding 编辑, Source={x:Static lang:MultiLang.Instance}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Width="90"
                                                Command="{Binding DataContext.DeletePointMapGroupCommand, IsAsync=True, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding 删除, Source={x:Static lang:MultiLang.Instance}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="{Binding 设置_其它, Source={x:Static lang:MultiLang.Instance}}">
                    <Grid Margin="10,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <CheckBox
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            materialDesign:TextBlockAssist.AutoToolTip="True"
                            Content="{Binding 设置_自动检查更新, Source={x:Static lang:MultiLang.Instance}}"
                            IsChecked="{Binding Others_CheckUpdate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignFilterChipPrimaryCheckBox}"
                            ToolTip="{Binding 设置_自动检查更新, Source={x:Static lang:MultiLang.Instance}}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding NewerVersion}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Width="120"
                            HorizontalAlignment="Right"
                            Command="{Binding UpgradeCommand}"
                            Content="{Binding 设置_立即升级, Source={x:Static lang:MultiLang.Instance}}"
                            Visibility="{Binding UpgradeVisibility}" />
                        <ProgressBar
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            materialDesign:TransitionAssist.DisableTransitions="True"
                            Visibility="{Binding UpgradingVisibility}"
                            Value="{Binding DownloadProgress}" />
                    </Grid>
                </TabItem>
            </TabControl>
            <StackPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,20,0"
                    Command="{Binding SaveSettingCommand}"
                    Content="{Binding 确定, Source={x:Static lang:MultiLang.Instance}}" />
                <Button
                    Margin="20,0,0,0"
                    Command="{Binding ResetSettingCommand}"
                    Content="{Binding 取消, Source={x:Static lang:MultiLang.Instance}}"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>