<UserControl
    x:Class="org.Ui.Poseidon.Views.LivingTracingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mconvt="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
    xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:selectors="clr-namespace:org.Ui.Selectors;assembly=org.Ui"
    xmlns:viewModels="clr-namespace:org.Ui.Poseidon.ViewModels"
    d:DesignHeight="758"
    d:DesignWidth="1238"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ListView
            Grid.Row="0"
            MaxHeight="100"
            materialDesign:ListBoxItemAssist.ShowSelection="False"
            IsHitTestVisible="{Binding IsRunning, Converter={x:Static mconvt:InvertBooleanConverter.Instance}}"
            ItemsSource="{Binding Points}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel VerticalAlignment="Top" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ToggleButton
                            Background="{Binding Background}"
                            Command="{Binding DataContext.EnableTracedCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}, IsAsync=True}"
                            CommandParameter="{Binding}"
                            IsChecked="{Binding IsSelected}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        <TextBlock
                            Width="130"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding Display}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <WrapPanel Grid.Row="1">
            <StackPanel Margin="20,0,20,0" Orientation="Horizontal">
                <TextBlock
                    Width="90"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="刷新频率(ms): " />
                <materialDesign:NumericUpDown
                    Width="80"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Right"
                    IsEnabled="{Binding IsRunning, Converter={x:Static mconvt:InvertBooleanConverter.Instance}}"
                    Maximum="10000"
                    Minimum="{Binding MinimumInterval}"
                    Value="{Binding Interval}" />
            </StackPanel>
            <StackPanel Margin="20,0,20,0" Orientation="Horizontal">
                <TextBlock
                    Width="100"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="监控时长(min): " />
                <materialDesign:NumericUpDown
                    Width="80"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Right"
                    IsEnabled="{Binding IsRunning, Converter={x:Static mconvt:InvertBooleanConverter.Instance}}"
                    Maximum="1440"
                    Minimum="1"
                    Value="{Binding TimeSpanMinutes}" />
            </StackPanel>
            <StackPanel Margin="20,0,20,0" Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="20,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding StartTracingCommand, IsAsync=True}"
                    Content="开始"
                    IsEnabled="{Binding IsRunning, Converter={x:Static mconvt:InvertBooleanConverter.Instance}}" />
                <Button
                    Name="BtnStop"
                    Width="80"
                    Margin="20,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding StopTracingCommand, IsAsync=True}"
                    Content="停止"
                    IsEnabled="{Binding IsRunning}" />
            </StackPanel>
            <StackPanel Margin="20,0,20,0" Orientation="Horizontal">
                <TextBlock
                    Width="80"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="监控报告: " />
                <TextBox
                    Width="320"
                    Padding="0,0,0,0"
                    IsReadOnly="True"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding LogFilePath}" />
            </StackPanel>
        </WrapPanel>
        <ContentControl
            Grid.Row="2"
            Margin="0,20,0,0"
            Content="{Binding Content}" />
    </Grid>
</UserControl>
