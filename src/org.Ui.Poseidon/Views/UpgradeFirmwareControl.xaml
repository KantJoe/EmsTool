<UserControl
    x:Class="org.Ui.Poseidon.Views.UpgradeFirmwareControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mconvt="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
    xmlns:selectors="clr-namespace:org.Ui.Selectors;assembly=org.Ui"
    xmlns:viewModels="clr-namespace:org.Ui.Poseidon.ViewModels"
    d:DesignHeight="758"
    d:DesignWidth="1238"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">
    <Grid Margin="16,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="11" />
            <RowDefinition Height="*" />
            <RowDefinition Height="11" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer
            Name="SvLogs"
            Grid.Row="1"
            Grid.Column="0"
            Background="#FF303030"
            VerticalScrollBarVisibility="Auto">
            <ListView ItemsSource="{Binding Logs}" />
        </ScrollViewer>
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Margin="10,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*" />
                <ColumnDefinition Width="30*" />
                <ColumnDefinition Width="30*" />
                <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button
                Grid.Row="0"
                Grid.Column="0"
                Width="120"
                HorizontalAlignment="Left"
                Command="{Binding SelectFirmwareCommand, IsAsync=True}"
                Content="本地固件"
                IsEnabled="{Binding Upgrading, Converter={x:Static mconvt:InvertBooleanConverter.Instance}}" />
            <Button
                Grid.Row="0"
                Grid.Column="1"
                Width="120"
                HorizontalAlignment="Right"
                Command="{Binding UpgradeCommand, IsAsync=True}"
                Content="执行更新"
                IsEnabled="{Binding Upgrading, Converter={x:Static mconvt:InvertBooleanConverter.Instance}}" />

            <Button
                Grid.Row="0"
                Grid.Column="2"
                Width="120"
                HorizontalAlignment="Center"
                Background="Red"
                BorderThickness="0"
                Command="{Binding UpgradeCommand, IsAsync=True}"
                Content="取消执行"
                IsEnabled="{Binding Upgrading}"
                Style="{StaticResource MaterialDesignRaisedButton}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="{Binding FirmwareFilePath}" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="指定Ems: " />
            <ComboBox
                Name="CbLinks"
                Grid.Row="2"
                Grid.Column="1"
                Width="180"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsEnabled="{Binding Upgrading, Converter={x:Static mconvt:InvertBooleanConverter.Instance}}"
                ItemsSource="{Binding Links}"
                SelectedItem="{Binding SelectedLink}"
                SelectionChanged="CbLinks_SelectionChanged" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="当前Ems固件版本: " />
            <TextBlock
                Grid.Row="3"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding Message.EmsFirmwareVersion}" />
        </Grid>
        <Rectangle
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,5,0,5"
            Fill="DarkGray" />

        <StackPanel
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <ProgressBar
                Height="10"
                Maximum="100"
                Minimum="0"
                SmallChange="0.1"
                Value="{Binding ProgressValue}" />
        </StackPanel>
    </Grid>
</UserControl>
