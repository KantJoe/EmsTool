<UserControl
    x:Class="org.Ui.Poseidon.Views.DeviceStatusOfSystemSummaryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:convt="clr-namespace:org.Ui.Converters;assembly=org.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="clr-namespace:org.Ui.Selectors;assembly=org.Ui"
    xmlns:viewModels="clr-namespace:org.Ui.Poseidon.ViewModels"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,10,0,10" Orientation="Vertical">
            <StackPanel
                Margin="10,0,10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Orientation="Horizontal">
                <materialDesign:Card
                    Width="340"
                    Height="350"
                    Margin="0,0,10,0"
                    materialDesign:ElevationAssist.Elevation="Dp16">
                    <StackPanel
                        Margin="5,10,5,10"
                        VerticalAlignment="Top"
                        Orientation="Vertical">
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_散热类型, Source={x:Static lang:MultiLang.Instance}, FallbackValue=散热类型}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding Message.DissipationType}" />
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_系统状态, Source={x:Static lang:MultiLang.Instance}, FallbackValue=系统状态}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding Message.SystemStateText}" />
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_运行模式, Source={x:Static lang:MultiLang.Instance}, FallbackValue=运行模式}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding Message.RunningModeText}" />
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_离并网状态, Source={x:Static lang:MultiLang.Instance}, FallbackValue=离并网状态}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding Message.GridConnectedText}" />
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_联网状态, Source={x:Static lang:MultiLang.Instance}, FallbackValue=联网状态}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding Message.OnlinedText}" />
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_EMS状态, Source={x:Static lang:MultiLang.Instance}, FallbackValue=EMS状态}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding Message.EmsStateText}" />
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_配置文件代码, Source={x:Static lang:MultiLang.Instance}, FallbackValue=配置文件代码}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding Message.ConfigFileCode}" />
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_风扇转速, Source={x:Static lang:MultiLang.Instance}, FallbackValue=风扇转速}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{Binding Message.FanRpmText, FallbackValue=NC}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text=" Rpm" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_系统额定功率, Source={x:Static lang:MultiLang.Instance}, FallbackValue=系统额定功率}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{Binding Message.StateOfChargeText, FallbackValue=-}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text=" Kw" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_湿度01, Source={x:Static lang:MultiLang.Instance}, FallbackValue=湿度01}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{Binding Message.Humidity01, FallbackValue=-}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text=" %" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_湿度02, Source={x:Static lang:MultiLang.Instance}, FallbackValue=湿度02}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{Binding Message.Humidity02, FallbackValue=-}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text=" %" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_温度01, Source={x:Static lang:MultiLang.Instance}, FallbackValue=温度01}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{Binding Message.Temperature01, FallbackValue=-}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text=" ℃" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_温度02, Source={x:Static lang:MultiLang.Instance}, FallbackValue=温度02}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{Binding Message.Temperature02, FallbackValue=-}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text=" ℃" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_温度03, Source={x:Static lang:MultiLang.Instance}, FallbackValue=温度03}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{Binding Message.Temperature03, FallbackValue=-}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text=" ℃" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_温度04, Source={x:Static lang:MultiLang.Instance}, FallbackValue=温度04}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{Binding Message.Temperature04, FallbackValue=-}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text=" ℃" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_EMS固件版本, Source={x:Static lang:MultiLang.Instance}, FallbackValue=EMS固件版本}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding Message.EmsFirmware}" />
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_BMS固件版本, Source={x:Static lang:MultiLang.Instance}, FallbackValue=BMS固件版本}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding Message.BmsFirmware}" />
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_HMI固件版本, Source={x:Static lang:MultiLang.Instance}, FallbackValue=HMI固件版本}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding Message.HmiFirmware}" />
                        </DockPanel>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card
                    Width="340"
                    Height="350"
                    Margin="0,0,10,0"
                    materialDesign:ElevationAssist.Elevation="Dp16"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        Margin="5,10,5,10"
                        VerticalAlignment="Top"
                        Orientation="Vertical">
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Vertical">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_模组联机状态HL, Source={x:Static lang:MultiLang.Instance}, FallbackValue=模组联机状态 H and L}" />
                            <WrapPanel
                                Margin="10,0,0,0"
                                IsHitTestVisible="True"
                                Orientation="Horizontal">
                                <CheckBox Content="{Binding 设备状态_Bit00BMS, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit00 BMS}" IsChecked="{Binding Message.BmsOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit01消防, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit01 消防}" IsChecked="{Binding Message.FireOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit02PCS, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit02 PCS}" IsChecked="{Binding Message.PcsOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit03DCDC, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit03 DCDC}" IsChecked="{Binding Message.DcdcOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit04MPPT, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit04 MPPT}" IsChecked="{Binding Message.MpptOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit05STS, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit05 STS}" IsChecked="{Binding Message.StsOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit06电表, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit06 电表}" IsChecked="{Binding Message.ElectricOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit07空调, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit07 空调}" IsChecked="{Binding Message.AirConditionOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit08液冷机组, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit08 液冷机组}" IsChecked="{Binding Message.LiquidOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit09HMI, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit09 HMI}" IsChecked="{Binding Message.HmiOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit10PC, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit10 PC}" IsChecked="{Binding Message.PcOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit11GPS, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit11 GPS}" IsChecked="{Binding Message.GpsOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit12FourG, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit12 4G}" IsChecked="{Binding Message.FourGOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit13Wifi, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit13 Wifi}" IsChecked="{Binding Message.WifiOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit14蓝牙, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit14 蓝牙}" IsChecked="{Binding Message.BluetoothOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit15LAN1, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit15 LAN1}" IsChecked="{Binding Message.Lan1OnlineState, Mode=OneWay}" />
                            </WrapPanel>
                            <Rectangle
                                Height="1"
                                Margin="10,0,0,0"
                                Stroke="DimGray" />
                            <WrapPanel Margin="10,0,0,0">
                                <CheckBox Content="{Binding 设备状态_Bit00LAN2, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit00 LAN2}" IsChecked="{Binding Message.Lan2OnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit01温湿度, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit01 温湿度}" IsChecked="{Binding Message.HumidityAndTempOnlineState, Mode=OneWay}" />
                                <CheckBox Content="{Binding 设备状态_Bit02并机通讯, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Bit02 并机通讯}" IsChecked="{Binding Message.GridConnectedOnlineState, Mode=OneWay}" />
                            </WrapPanel>
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_系统故障, Source={x:Static lang:MultiLang.Instance}, FallbackValue=系统故障}" />
                            <WrapPanel
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Width="30"
                                    Margin="0,0,20,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding Message.Fault01, Converter={x:Static convt:UshortToBrushConverter.Green}}"
                                    TextAlignment="Right"
                                    ToolTip="{Binding Message.Fault01}" />
                                <TextBlock
                                    Width="30"
                                    Margin="0,0,20,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding Message.Fault02, Converter={x:Static convt:UshortToBrushConverter.Green}}"
                                    TextAlignment="Right"
                                    ToolTip="{Binding Message.Fault02}" />
                                <TextBlock
                                    Width="30"
                                    Margin="0,0,20,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding Message.Fault03, Converter={x:Static convt:UshortToBrushConverter.Green}}"
                                    TextAlignment="Right"
                                    ToolTip="{Binding Message.Fault03}" />
                                <TextBlock
                                    Width="30"
                                    Margin="0,0,20,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding Message.Fault04, Converter={x:Static convt:UshortToBrushConverter.Green}}"
                                    TextAlignment="Right"
                                    ToolTip="{Binding Message.Fault04}" />
                                <TextBlock
                                    Width="30"
                                    Margin="0,0,20,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding Message.Fault05, Converter={x:Static convt:UshortToBrushConverter.Green}}"
                                    TextAlignment="Right"
                                    ToolTip="{Binding Message.Fault05}" />
                            </WrapPanel>
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_系统告警, Source={x:Static lang:MultiLang.Instance}, FallbackValue=系统告警}" />
                            <WrapPanel
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Width="30"
                                    Margin="0,0,20,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding Message.Warning01, Converter={x:Static convt:UshortToBrushConverter.Green}}"
                                    TextAlignment="Right"
                                    ToolTip="{Binding Message.Warning01}" />
                                <TextBlock
                                    Width="30"
                                    Margin="0,0,20,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding Message.Warning02, Converter={x:Static convt:UshortToBrushConverter.Green}}"
                                    TextAlignment="Right"
                                    ToolTip="{Binding Message.Warning02}" />
                                <TextBlock
                                    Width="30"
                                    Margin="0,0,20,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding Message.Warning03, Converter={x:Static convt:UshortToBrushConverter.Green}}"
                                    TextAlignment="Right"
                                    ToolTip="{Binding Message.Warning03}" />
                                <TextBlock
                                    Width="30"
                                    Margin="0,0,20,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding Message.Warning04, Converter={x:Static convt:UshortToBrushConverter.Green}}"
                                    TextAlignment="Right"
                                    ToolTip="{Binding Message.Warning04}" />
                                <TextBlock
                                    Width="30"
                                    Margin="0,0,20,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding Message.Warning05, Converter={x:Static convt:UshortToBrushConverter.Green}}"
                                    TextAlignment="Right"
                                    ToolTip="{Binding Message.Warning05}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card
                    Width="460"
                    Height="350"
                    materialDesign:ElevationAssist.Elevation="Dp16">
                    <StackPanel
                        Margin="5,10,5,10"
                        VerticalAlignment="Top"
                        Orientation="Vertical">
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Vertical">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_BMS联机状态, Source={x:Static lang:MultiLang.Instance}, FallbackValue=BMS联机状态}" />
                            <ListView
                                Margin="10,0,0,0"
                                materialDesign:ListBoxItemAssist.ShowSelection="False"
                                ItemsSource="{Binding Message.BmsOnlines}">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel
                                            Height="32"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <CheckBox Content="{Binding Key, Mode=OneWay}" IsChecked="{Binding IsChecked}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Vertical">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_PCS联机状态, Source={x:Static lang:MultiLang.Instance}, FallbackValue=PCS联机状态}" />
                            <ListView
                                Margin="10,0,0,0"
                                materialDesign:ListBoxItemAssist.ShowSelection="False"
                                ItemsSource="{Binding Message.PcsOnlines}">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel
                                            Height="32"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <CheckBox Content="{Binding Key, Mode=OneWay}" IsChecked="{Binding IsChecked}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Vertical">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_DCDC联机状态, Source={x:Static lang:MultiLang.Instance}, FallbackValue=DCDC联机状态}" />
                            <ListView
                                Margin="10,0,0,0"
                                materialDesign:ListBoxItemAssist.ShowSelection="False"
                                ItemsSource="{Binding Message.DcdcOnlines}">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel
                                            Height="32"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <CheckBox Content="{Binding Key, Mode=OneWay}" IsChecked="{Binding IsChecked}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Vertical">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_MPPT联机状态, Source={x:Static lang:MultiLang.Instance}, FallbackValue=MPPT联机状态}" />
                            <ListView
                                Margin="10,0,0,0"
                                materialDesign:ListBoxItemAssist.ShowSelection="False"
                                ItemsSource="{Binding Message.MpptOnlines}">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel
                                            Height="32"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <CheckBox Content="{Binding Key, Mode=OneWay}" IsChecked="{Binding IsChecked}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Vertical">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding 设备状态_Meter联机状态, Source={x:Static lang:MultiLang.Instance}, FallbackValue=Meter联机状态}" />
                            <ListView
                                Margin="10,0,0,0"
                                materialDesign:ListBoxItemAssist.ShowSelection="False"
                                ItemsSource="{Binding Message.MeterOnlines}">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel
                                            Height="32"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <CheckBox Content="{Binding Key, Mode=OneWay}" IsChecked="{Binding IsChecked}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
            <ContentControl
                Name="ExtendContent"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="{Binding ExtendContent}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
