<Window
    x:Class="org.Ui.Poseidon.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="600"
    Height="400"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Name="PicMain"
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Margin="10,0,0,0"/>
                    <TextBlock
                        Name="TbTitle"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="LightGray"
                        TextWrapping="NoWrap" />
                </Grid>
                <!--<StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Name="BtnMinimun"
                        Width="48"
                        Height="28"
                        BorderThickness="0"
                        Click="BtnMinimun_Click"
                        Content="_"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignOutlinedSecondaryLightButton}" />
                    <Button
                        Name="BtnMaximun"
                        Width="48"
                        Height="28"
                        BorderThickness="0"
                        Click="BtnMaximun_Click"
                        Content="■"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignOutlinedSecondaryLightButton}" />
                    <Button
                        Width="48"
                        Height="28"
                        Background="Red"
                        BorderThickness="0"
                        Command="ApplicationCommands.Close"
                        Content="X"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignOutlinedSecondaryLightButton}" />
                </StackPanel>-->
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.06" Color="#56C500" />
                        <GradientStop Offset="0.14" Color="#54C405" />
                        <GradientStop Offset="0.23" Color="#4FC416" />
                        <GradientStop Offset="0.33" Color="#46C331" />
                        <GradientStop Offset="0.43" Color="#3BC357" />
                        <GradientStop Offset="0.45" Color="#2CC286" />
                        <GradientStop Offset="0.51" Color="#2AC28F" />
                        <GradientStop Offset="0.58" Color="#1DBDAD" />
                        <GradientStop Offset="0.66" Color="#12B8C8" />
                        <GradientStop Offset="0.74" Color="#0AB5DC" />
                        <GradientStop Offset="1" Color="#04B2EB" />
                    </LinearGradientBrush>
                </Grid.Background>
            </Grid>
            <Grid
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="85*" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="15*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Vertical">
                    <TextBlock
                        Height="30"
                        Margin="10,5,0,0"
                        Text="{Binding 语言, Source={x:Static lang:MultiLang.Instance}}" />
                    <ComboBox
                        Width="240"
                        materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding LangItems, Source={x:Static lang:MultiLang.Instance}}"
                        SelectedItem="{Binding SelectedLang, Source={x:Static lang:MultiLang.Instance}}">
                        <Behaviors:Interaction.Triggers>
                            <Behaviors:EventTrigger EventName="SelectionChanged">
                                <Behaviors:InvokeCommandAction Command="{Binding SwitchLanguageCommand}" />
                            </Behaviors:EventTrigger>
                        </Behaviors:Interaction.Triggers>
                    </ComboBox>
                    <!--<TextBlock
                        Height="30"
                        Margin="10,5,0,0"
                        Text="站点" />
                    <ComboBox Width="240" materialDesign:ComboBoxAssist.ShowSelectedItem="True">
                        <ComboBoxItem Content="中国" IsSelected="True" />
                        <ComboBoxItem Content="英格兰" />
                        <ComboBoxItem Content="丹麦" />
                        <ComboBoxItem Content="德国" />
                    </ComboBox>-->
                    <TextBlock
                        Name="LbAccount"
                        Height="30"
                        Margin="10,5,0,0"
                        Text="{Binding 账号, Source={x:Static lang:MultiLang.Instance}}" />
                    <TextBox
                        Name="TxtAccount"
                        Width="240"
                        Text="{Binding Account}" />
                    <TextBlock
                        Name="LbPasswd"
                        Height="30"
                        Margin="10,5,0,0"
                        Text="{Binding 密码, Source={x:Static lang:MultiLang.Instance}}" />
                    <PasswordBox
                        Name="TxtPasswd"
                        Width="240"
                        materialDesign:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay}"
                        materialDesign:TextFieldAssist.HasClearButton="True" />
                    <TextBlock
                        Height="30"
                        Margin="10,5,0,0"
                        Text="{Binding 项目, Source={x:Static lang:MultiLang.Instance}}" />
                    <ComboBox
                        Width="240"
                        materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                        ItemsSource="{Binding ProjectNames}"
                        SelectedItem="{Binding SelectedProject}" />
                    <StackPanel
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding ImportProjectCommand}"
                            Content="{Binding 导入, Source={x:Static lang:MultiLang.Instance}}"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding ExportProjectCommand}"
                            Content="{Binding 导出, Source={x:Static lang:MultiLang.Instance}}"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding CreateProjectCommand}"
                            Content="{Binding 创建, Source={x:Static lang:MultiLang.Instance}}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Visibility="Hidden" />
                    </StackPanel>
                </StackPanel>
                <Rectangle
                    Grid.Row="1"
                    Margin="10,0,10,0"
                    Fill="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" />
                <Grid
                    Grid.Row="2"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Name="BtnLogin"
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        Click="BtnLogin_Click"
                        Content="{Binding 本地连接, Source={x:Static lang:MultiLang.Instance}}"
                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
                    <Button
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        Content="{Binding 登入, Source={x:Static lang:MultiLang.Instance}}"
                        IsEnabled="False" />
                    <Button
                        Grid.Column="3"
                        Margin="10,0,0,0"
                        Command="ApplicationCommands.Close"
                        Content="{Binding 退出, Source={x:Static lang:MultiLang.Instance}}"
                        Style="{StaticResource MaterialDesignFlatLightButton}" />
                </Grid>

            </Grid>
            <ScrollViewer
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,10,0,0"
                VerticalScrollBarVisibility="Auto">
                <ListBox
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False"
                    ItemsSource="{Binding Products}"
                    Style="{StaticResource MaterialDesignChoiceChipPrimaryListBox}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Grid
                                            Width="180"
                                            Height="100"
                                            Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="60"
                                                Height="60"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Kind="SlotMachine" />
                                            <StackPanel
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Orientation="Vertical">
                                                <TextBlock Text="型号:Product01" />
                                                <TextBlock Text="序号:" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </materialDesign:Card>
</Window>
