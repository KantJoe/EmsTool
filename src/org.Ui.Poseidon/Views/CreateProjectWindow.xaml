<Window
    x:Class="org.Ui.Poseidon.Views.CreateProjectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uiExt="clr-namespace:org.Ui.Extensions;assembly=org.Ui"
    xmlns:valid="clr-namespace:org.Ui.ValidationRules;assembly=org.Ui"
    Width="520"
    Height="480"
    uiExt:DialogCloser.DialogResult="{Binding DialogResult}"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="11" />
                <RowDefinition Height="*" />
                <RowDefinition Height="11" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Name="PicMain"
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Margin="10,0,0,0" />
                    <TextBlock
                        Name="TbTitle"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="LightGray"
                        Style="{StaticResource MaterialDesignTitleMediumTextBlock}"
                        Text="{Binding 创建项目_创建项目, Source={x:Static lang:MultiLang.Instance}}"
                        TextWrapping="NoWrap" />
                </Grid>
            </Grid>
            <Rectangle
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,0,0,10"
                Fill="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" />
            <StackPanel
                Grid.Row="2"
                Grid.Column="0"
                Margin="15,0,0,0"
                HorizontalAlignment="Left"
                Orientation="Vertical">
                <TextBlock
                    Height="24"
                    Margin="0,7,0,0"
                    VerticalAlignment="Center"
                    materialDesign:ValidationAssist.HorizontalAlignment="Left"
                    Text="{Binding 创建项目_项目名, Source={x:Static lang:MultiLang.Instance}}" />
                <TextBox Width="210" Margin="40,0,0,0">
                    <TextBox.Text>
                        <Binding Path="ProjectName" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <valid:LengthValidRule MinLength="4" ValidatesOnTargetUpdated="True" />
                                <valid:OnlyAlphabetAndNumbersValidRule ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <TextBlock
                    Height="24"
                    Margin="0,7,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding 创建项目_协议类型, Source={x:Static lang:MultiLang.Instance}}" />
                <ComboBox
                    Width="210"
                    Margin="40,0,0,0"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding Protocols}"
                    SelectedItem="{Binding SelectedProtocol}" />
            </StackPanel>
            <TabControl Grid.Row="2" Grid.Column="1">
                <TabItem Header="设备默认参数" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        Margin="15,0,0,0"
                        HorizontalAlignment="Left"
                        Orientation="Vertical">
                        <TextBlock
                            Height="24"
                            Margin="0,7,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="从站地址: " />
                        <materialDesign:NumericUpDown
                            Width="180"
                            Margin="40,0,0,0"
                            Maximum="255"
                            Minimum="1"
                            Value="{Binding SlaveId}" />
                        <TextBlock
                            Width="180"
                            Height="24"
                            Margin="0,7,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="串口号/IP: " />
                        <TextBox
                            Width="210"
                            Margin="40,0,0,0"
                            Text="{Binding PortName}" />
                        <TextBlock
                            Height="24"
                            Margin="0,7,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="端口: " />
                        <materialDesign:NumericUpDown
                            Width="180"
                            Margin="40,0,0,0"
                            Maximum="65535"
                            Minimum="1001"
                            Value="{Binding Port}" />
                    </StackPanel>
                </TabItem>
            </TabControl>
            <Rectangle
                Grid.Row="3"
                Grid.ColumnSpan="2"
                Margin="0,0,0,10"
                Fill="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" />
            <StackPanel
                Grid.Row="4"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="0,0,10,0"
                    Command="{Binding CreateProjectCommand, IsAsync=True}"
                    Content="{Binding 创建, Source={x:Static lang:MultiLang.Instance}}"
                    Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
                <Button
                    Width="80"
                    Margin="10,0,0,0"
                    Command="ApplicationCommands.Close"
                    Content="{Binding 取消, Source={x:Static lang:MultiLang.Instance}}" />
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</Window>
