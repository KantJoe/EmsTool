                    <StackPanel Margin="0,0,10,0" Orientation="Vertical">
                        <DockPanel Margin="0,10,0,0" HorizontalAlignment="Stretch">
                            <materialDesign:Card Width="1060">
                                <StackPanel Margin="20,0,20,20" Orientation="Vertical">
                                    <Button
                                        Width="180"
                                        Margin="0,20,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding RebootSystemCommand, IsAsync=True}"
                                        Content="{Binding 系统设置_系统重启, Source={x:Static lang:MultiLang.Instance}, FallbackValue=系统重启}" />
                                    <Button
                                        Width="180"
                                        Margin="0,20,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ResetSystemFaultsCommand, IsAsync=True}"
                                        Content="{Binding 系统设置_系统故障复位, Source={x:Static lang:MultiLang.Instance}, FallbackValue=系统故障复位}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Width="180"
                                            Margin="0,20,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding FactoryReset01Command, IsAsync=True}"
                                            Content="{Binding 系统设置_一级恢复出厂设置, Source={x:Static lang:MultiLang.Instance}, FallbackValue=一级恢复出厂设置}" />
                                        <TextBlock
                                            Margin="20,20,0,0"
                                            VerticalAlignment="Center"
                                            Text="注：研发使用：SN码、采集器参数不清除其它都清除（ATE使用）" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Width="180"
                                            Margin="0,20,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding FactoryReset02Command, IsAsync=True}"
                                            Content="{Binding 系统设置_二级恢复出厂设置, Source={x:Static lang:MultiLang.Instance}, FallbackValue=二级恢复出厂设置}" />
                                        <TextBlock
                                            Margin="20,20,0,0"
                                            VerticalAlignment="Center"
                                            Text="注：生产使用：只恢复运行参数，发电量、故障记录" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Width="180"
                                            Margin="0,20,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding FactoryReset03Command, IsAsync=True}"
                                            Content="{Binding 系统设置_三级恢复出厂设置, Source={x:Static lang:MultiLang.Instance}, FallbackValue=三级恢复出厂设置}" />
                                        <TextBlock
                                            Margin="20,20,0,0"
                                            VerticalAlignment="Center"
                                            Text="注：客户使用：只恢复运行参数" />
                                    </StackPanel>
                                </StackPanel>
