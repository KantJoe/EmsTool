    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:convt="clr-namespace:org.Ui.Converters;assembly=org.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="clr-namespace:org.Ui.Selectors;assembly=org.Ui"
    xmlns:viewModels="clr-namespace:org.Ui.Poseidon.ViewModels"
    d:DesignHeight="758"
    d:DesignWidth="1248"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">

    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock
                Width="120"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="{Binding 指定EMS, Source={x:Static lang:MultiLang.Instance}, FallbackValue=指定EMS}" />
            <ComboBox
                Width="180"
                ItemsSource="{Binding Links}"
                SelectedItem="{Binding SelectedLink}">
                <Behaviors:Interaction.Triggers>
                    <Behaviors:EventTrigger EventName="SelectionChanged">
                        <Behaviors:InvokeCommandAction Command="{Binding SelectLinkChangedCommand}" />
                    </Behaviors:EventTrigger>
                </Behaviors:Interaction.Triggers>
            </ComboBox>
        </StackPanel>
        <TabControl
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Style="{StaticResource MaterialDesignFilledTabControl}">
            <TabItem Header="{Binding 系统设置_系统参数01, Source={x:Static lang:MultiLang.Instance}, FallbackValue=系统参数01}">
