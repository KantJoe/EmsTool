            <TabItem Header="{Binding 系统设置_48时段设置, Source={x:Static lang:MultiLang.Instance}, FallbackValue=48 时段设置}">
                <Grid>
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock Width="120" Text="{Binding 系统设置_对应时段表, Source={x:Static lang:MultiLang.Instance}, FallbackValue=对应时段表}" />
                        <ComboBox
                            Width="180"
                            ItemsSource="{Binding PeriodTimers}"
                            SelectedItem="{Binding SelectedTimer}" />

                    </StackPanel>
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{Binding TimeSlots48}"
                        SelectedItem="{Binding SelectedTimeSlot48}"
                        VirtualizingPanel.CacheLength="30"
                        VirtualizingPanel.CacheLengthUnit="Item"
                        VirtualizingPanel.IsContainerVirtualizable="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Item"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn
                                    Width="120"
                                    DisplayMemberBinding="{Binding Time}"
                                    Header="Time" />
                                <GridViewColumn Width="120" Header="Value">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <materialDesign:DecimalUpDown
                                                Maximum="1000"
                                                Minimum="-1000"
                                                ValueStep="0.5"
                                                Value="{Binding Value}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,20,0"
                            Command="{Binding Reset48TimeSlotCommand, IsAsync=True}"
                            Content="{Binding 复位, Source={x:Static lang:MultiLang.Instance}, FallbackValue=复位}" />
                        <Button
                            Margin="0,0,20,0"
                            Command="{Binding Query48TimeSlotDataCommand, IsAsync=True}"
                            Content="{Binding 读取, Source={x:Static lang:MultiLang.Instance}, FallbackValue=读取}" />
                        <Button
                            Margin="20,0,40,0"
                            Command="{Binding Write48TimeSlotCommand, IsAsync=True}"
                            Content="{Binding 下发, Source={x:Static lang:MultiLang.Instance}, FallbackValue=下发}" />
                    </StackPanel>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

