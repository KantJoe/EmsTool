<UserControl
    x:Class="org.Ui.Poseidon.Views.AppendMqttControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mconvt="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
    xmlns:selectors="clr-namespace:org.Ui.Selectors;assembly=org.Ui"
    xmlns:viewModels="clr-namespace:org.Ui.Poseidon.ViewModels"
    d:DesignHeight="120"
    d:DesignWidth="240"
    mc:Ignorable="d">
    <StackPanel VerticalAlignment="Bottom" Orientation="Vertical">
        <TextBox Name="TxtName" Height="30" />
        <DockPanel
            Margin="0,10,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
            <Button
                Name="BtnConfirm"
                Width="110"
                HorizontalAlignment="Left"
                Click="BtnConfirm_Click" />
            <Button
                Name="BtnCancel"
                Width="110"
                HorizontalAlignment="Right"
                Click="BtnCancel_Click" />
        </DockPanel>
    </StackPanel>
</UserControl>
