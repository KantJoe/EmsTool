<UserControl
    x:Class="org.Ui.Poseidon.Views.PointMapMultipleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:org.Ui.Converters;assembly=org.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="758"
    d:DesignWidth="1056"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="pointMapHeader">
            <StackPanel Width="auto" Height="auto">
                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"
                    Kind="ViewGridCompact" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="10"
                    Text="{Binding GroupName}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="pointMapContent">
            <ListView
                ItemsSource="{Binding Points}"
                SelectedItem="{Binding SelectedPoint}"
                VirtualizingPanel.CacheLength="125"
                VirtualizingPanel.CacheLengthUnit="Item"
                VirtualizingPanel.IsContainerVirtualizable="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Item"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Address}" Header="Address" />
                        <GridViewColumn DisplayMemberBinding="{Binding Description}" Header="Description" />
                        <GridViewColumn DisplayMemberBinding="{Binding DataType}" Header="DataType" />
                        <GridViewColumn DisplayMemberBinding="{Binding Kind}" Header="Kind" />
                        <GridViewColumn DisplayMemberBinding="{Binding ActualValue}" Header="ActualValue" />
                        <GridViewColumn Header="Options">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="{Binding 读取, Source={x:Static lang:MultiLang.Instance}}" Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
                                        <Button
                                            Content="{Binding 下发, Source={x:Static lang:MultiLang.Instance}}"
                                            Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                                            Visibility="{Binding FunctionCode, Converter={x:Static converter:EnumToVisibleConverter.HoldingRegister}}" />
                                    </WrapPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer
        Height="7000"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,10,10,10" Orientation="Vertical">
            <materialDesign:Card>
                <Expander
                    MinWidth="940"
                    HorizontalAlignment="Left"
                    materialDesign:ExpanderAssist.HeaderBackground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    materialDesign:ExpanderAssist.HorizontalHeaderPadding="72,10,0,10"
                    FontWeight="Bold"
                    Header="{Binding 点位表_功能码4, Source={x:Static lang:MultiLang.Instance}}"
                    IsExpanded="False">
                    <TabControl
                        materialDesign:ColorZoneAssist.Mode="SecondaryMid"
                        materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                        ContentTemplate="{StaticResource pointMapContent}"
                        ItemTemplate="{StaticResource pointMapHeader}"
                        ItemsSource="{Binding PointMapsOf4}"
                        SelectedItem="{Binding SelectedPointMapOf4}"
                        SnapsToDevicePixels="True"
                        Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                        TabStripPlacement="Left"
                        VirtualizingPanel.CacheLength="1"
                        VirtualizingPanel.CacheLengthUnit="Item"
                        VirtualizingPanel.IsContainerVirtualizable="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Item"
                        VirtualizingPanel.VirtualizationMode="Recycling" />
                </Expander>
            </materialDesign:Card>
            <materialDesign:Card Margin="0,30,0,0">
                <Expander
                    MinWidth="940"
                    HorizontalAlignment="Left"
                    materialDesign:ExpanderAssist.HeaderBackground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    materialDesign:ExpanderAssist.HorizontalHeaderPadding="72,10,0,10"
                    FontWeight="Bold"
                    Header="{Binding 点位表_功能码3, Source={x:Static lang:MultiLang.Instance}}"
                    IsExpanded="False">
                    <TabControl
                        materialDesign:ColorZoneAssist.Mode="SecondaryMid"
                        materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                        ContentTemplate="{StaticResource pointMapContent}"
                        ItemTemplate="{StaticResource pointMapHeader}"
                        ItemsSource="{Binding PointMapsOf3}"
                        SelectedItem="{Binding SelectedPointMapOf3}"
                        SnapsToDevicePixels="True"
                        Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                        TabStripPlacement="Left"
                        VirtualizingPanel.CacheLength="1"
                        VirtualizingPanel.CacheLengthUnit="Item"
                        VirtualizingPanel.IsContainerVirtualizable="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Item"
                        VirtualizingPanel.VirtualizationMode="Recycling" />
                </Expander>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
