<UserControl
    x:Class="org.Ui.Poseidon.Views.LoginControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="520"
    Height="400"
    TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">
    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="{StaticResource TitleBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Name="PicMain"
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Margin="10,0,0,0" />
                    <TextBlock
                        Name="TbTitle"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="LightGray"
                        Style="{StaticResource MaterialDesignTitleMediumTextBlock}"
                        TextWrapping="NoWrap" />
                </Grid>
            </Grid>
            <Grid
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="85*" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="15*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Vertical">
                    <TextBlock
                        Height="30"
                        Margin="10,5,0,0"
                        Text="{Binding 语言, Source={x:Static lang:MultiLang.Instance}}" />
                    <ComboBox
                        Name="CbLanguage"
                        Width="240"
                        materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding LangItems, Source={x:Static lang:MultiLang.Instance}}"
                        SelectedItem="{Binding SelectedLang, Source={x:Static lang:MultiLang.Instance}}">
                        <Behaviors:Interaction.Triggers>
                            <Behaviors:EventTrigger EventName="SelectionChanged">
                                <Behaviors:InvokeCommandAction Command="{Binding SwitchLanguageCommand}" />
                            </Behaviors:EventTrigger>
                        </Behaviors:Interaction.Triggers>
                    </ComboBox>
                    <!--<TextBlock
                        Height="30"
                        Margin="10,5,0,0"
                        Text="站点" />
                    <ComboBox Width="240" materialDesign:ComboBoxAssist.ShowSelectedItem="True">
                        <ComboBoxItem Content="中国" IsSelected="True" />
                        <ComboBoxItem Content="英格兰" />
                        <ComboBoxItem Content="丹麦" />
                        <ComboBoxItem Content="德国" />
                    </ComboBox>-->
                    <TextBlock
                        Name="LbAccount"
                        Height="30"
                        Margin="10,5,0,0"
                        Text="{Binding 账号, Source={x:Static lang:MultiLang.Instance}}" />
                    <TextBox
                        Name="TxtAccount"
                        Width="240"
                        Text="{Binding Account}" />
                    <TextBlock
                        Name="LbPasswd"
                        Height="30"
                        Margin="10,5,0,0"
                        Text="{Binding 密码, Source={x:Static lang:MultiLang.Instance}}" />
                    <PasswordBox
                        Name="TxtPasswd"
                        Width="240"
                        materialDesign:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay}"
                        materialDesign:TextFieldAssist.HasClearButton="True" />
                    <TextBlock
                        Height="30"
                        Margin="10,5,0,0"
                        Text="{Binding 项目, Source={x:Static lang:MultiLang.Instance}}" />
                    <ComboBox
                        Name="CbProjects"
                        Width="240"
                        materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                        ItemsSource="{Binding ProjectNames}"
                        SelectedItem="{Binding SelectedProject}" />
                    <StackPanel
                        Margin="10,10,0,0"
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal">
                        <Button
                            Width="60"
                            Margin="0,0,10,0"
                            Command="{Binding ImportProjectCommand}"
                            Content="{materialDesign:PackIcon Import}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="{Binding 导入, Source={x:Static lang:MultiLang.Instance}}" />
                        <Button
                            Width="60"
                            Margin="10,0,0,0"
                            Command="{Binding ExportProjectCommand}"
                            Content="{materialDesign:PackIcon Export}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="{Binding 导出, Source={x:Static lang:MultiLang.Instance}}" />
                        <Button
                            Width="60"
                            Margin="10,0,0,0"
                            Command="{Binding CreateProjectCommand, IsAsync=True}"
                            Content="{materialDesign:PackIcon NewspaperPlus}"
                            Foreground="DodgerBlue"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="{Binding 创建, Source={x:Static lang:MultiLang.Instance}}" />
                        <Button
                            Width="60"
                            Margin="10,0,0,0"
                            Command="{Binding DeleteProjectCommand, IsAsync=True}"
                            Content="{materialDesign:PackIcon NewspaperRemove}"
                            Foreground="Red"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="{Binding 删除, Source={x:Static lang:MultiLang.Instance}}" />
                    </StackPanel>
                </StackPanel>
                <Rectangle
                    Grid.Row="1"
                    Margin="10,0,10,0"
                    Fill="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" />
                <Grid
                    Grid.Row="2"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Name="BtnLogin"
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Click="BtnLogin_Click"
                        Content="{Binding 本地连接, Source={x:Static lang:MultiLang.Instance}}"
                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
                    <Button
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        Content="{Binding 登入, Source={x:Static lang:MultiLang.Instance}}"
                        IsEnabled="False" />
                    <Button
                        Name="BtnCancel"
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        Click="BtnCancel_Click"
                        Content="{Binding 退出, Source={x:Static lang:MultiLang.Instance}}"
                        Style="{StaticResource MaterialDesignFlatLightButton}" />
                </Grid>

            </Grid>
            <Grid
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <materialDesign:PackIcon
                    Grid.Row="0"
                    Width="60"
                    Height="60"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Kind="SlotMachine" />
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Orientation="Vertical">
                    <TextBlock Text="型号:Product01" />
                    <TextBlock Text="序号:" />
                </StackPanel>
            </Grid>
        </Grid>
    </materialDesign:Card>
</UserControl>
