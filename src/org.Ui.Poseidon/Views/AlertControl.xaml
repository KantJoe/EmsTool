<UserControl
    x:Class="org.Ui.Poseidon.Views.AlertControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mconvt="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
    xmlns:selectors="clr-namespace:org.Ui.Selectors;assembly=org.Ui"
    xmlns:viewModels="clr-namespace:org.Ui.Poseidon.ViewModels"
    d:DesignHeight="758"
    d:DesignWidth="1238"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">
    <StackPanel Orientation="Vertical">
        <ListView
            Height="100"
            MaxHeight="200"
            materialDesign:ListBoxItemAssist.ShowSelection="False"
            ItemsSource="{Binding ModbusKeys}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel VerticalAlignment="Top" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ToggleButton
                            Command="{Binding DataContext.AllowAlertCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}, IsAsync=True}"
                            CommandParameter="{Binding}"
                            IsChecked="{Binding AllowAlert}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        <TextBlock
                            Width="130"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding Key}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ListView
            Grid.Row="2"
            ItemsSource="{Binding Points}"
            SelectedItem="{Binding SelectedPoint}"
            VirtualizingPanel.CacheLength="125"
            VirtualizingPanel.CacheLengthUnit="Item"
            VirtualizingPanel.IsContainerVirtualizable="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Item"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn
                        Width="160"
                        DisplayMemberBinding="{Binding ModbusKey}"
                        Header="ModbusKey" />
                    <GridViewColumn
                        Width="100"
                        DisplayMemberBinding="{Binding FunctionCode}"
                        Header="Code" />
                    <GridViewColumn
                        Width="120"
                        DisplayMemberBinding="{Binding Point.StartAddress}"
                        Header="Address" />
                    <GridViewColumn DisplayMemberBinding="{Binding Point.Condition}" Header="Condition" />
                    <!--<GridViewColumn DisplayMemberBinding="{Binding Point.ThresholdRangeValue}" Header="ThresholdRangeValue" />-->
                    <GridViewColumn DisplayMemberBinding="{Binding CurrentValue}" Header="CurrentValue" />
                    <GridViewColumn DisplayMemberBinding="{Binding AlertTimes}" Header="AlertTimes" />
                    <GridViewColumn Width="320" Header="Options">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Command="{Binding DataContext.DeletePointCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}, IsAsync=True}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding 删除, Source={x:Static lang:MultiLang.Instance}}"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button
                                        Command="{Binding DataContext.EditPointCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}, IsAsync=True}"
                                        CommandParameter="{Binding}"
                                        Content="编辑"
                                        Style="{StaticResource MaterialDesignFlatSecondaryButton}" />
                                    <Button
                                        Command="{Binding DataContext.ClearAlertLogCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}, IsAsync=True}"
                                        CommandParameter="{Binding}"
                                        Content="清空历史"
                                        Style="{StaticResource MaterialDesignFlatSecondaryButton}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</UserControl>
