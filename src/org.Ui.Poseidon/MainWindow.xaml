<Window
    x:Class="org.Ui.Poseidon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:comm="clr-namespace:org.Communication;assembly=org.Communication"
    xmlns:convert="clr-namespace:org.Ui.Converters;assembly=org.Ui"
    xmlns:convt="clr-namespace:org.Ui.Converters;assembly=org.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Ui.Poseidon"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:org.Ui;assembly=org.Ui"
    xmlns:viewModel="clr-namespace:org.Ui.Poseidon.ViewModels"
    Width="1280"
    Height="900"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    Style="{StaticResource MaterialDesignWindow}"
    TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  标题栏  -->
            <Grid Grid.Row="0" Background="{StaticResource TitleBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Name="PicMain"
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Margin="10,0,0,0" />
                    <TextBlock
                        Name="TbTitle"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignTitleMediumTextBlock}"
                        Text="org_EMS_Monitor_V"
                        TextWrapping="NoWrap" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Name="BtnMinimun"
                        Width="48"
                        Height="28"
                        BorderThickness="0"
                        Click="BtnMinimun_Click"
                        Content="_"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignOutlinedSecondaryLightButton}" />
                    <Button
                        Name="BtnMaximun"
                        Width="48"
                        Height="28"
                        BorderThickness="0"
                        Click="BtnMaximun_Click"
                        Content="■"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignOutlinedSecondaryLightButton}" />
                    <Button
                        Width="48"
                        Height="28"
                        Background="Red"
                        BorderThickness="0"
                        Command="ApplicationCommands.Close"
                        Content="X"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignOutlinedSecondaryLightButton}" />
                </StackPanel>
            </Grid>
            <!--  主体内容  -->
            <materialDesign:DialogHost
                Grid.Row="1"
                DialogTheme="Inherit"
                Identifier="{x:Static ui:UiGlobalContext.RootDialog}"
                OverlayBackground="{DynamicResource MaterialDesign.Brush.Primary.Dark}">
                <materialDesign:DialogHost.DialogContent>
                    <StackPanel Margin="16">
                        <ProgressBar
                            Margin="16"
                            HorizontalAlignment="Center"
                            IsIndeterminate="True"
                            Style="{StaticResource MaterialDesignCircularProgressBar}"
                            Value="0" />
                        <Button
                            HorizontalAlignment="Center"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            CommandParameter="Sample2Cancel"
                            Content="CANCEL"
                            IsCancel="True"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                    </StackPanel>
                </materialDesign:DialogHost.DialogContent>
                <materialDesign:DrawerHost
                    x:Name="DrawerHost"
                    BorderThickness="2"
                    IsLeftDrawerOpen="{Binding MenuOpened, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    OverlayBackground="{DynamicResource MaterialDesign.Brush.Primary}">
                    <materialDesign:DrawerHost.LeftDrawerContent>
                        <DockPanel MinWidth="180">
                            <ListBox
                                x:Name="DemoItemsListBox"
                                Margin="12,16,12,16"
                                AutomationProperties.Name="DemoPagesListBox"
                                ItemsSource="{Binding MenuItems}"
                                SelectedItem="{Binding SelectedMenu, UpdateSourceTrigger=PropertyChanged}">
                                <Behaviors:Interaction.Triggers>
                                    <Behaviors:EventTrigger EventName="PreviewMouseLeftButtonUp" SourceObject="{Binding ElementName=DemoItemsListBox}">
                                        <Behaviors:InvokeCommandAction Command="{Binding MenuSelectedCommand, IsAsync=True}" />
                                    </Behaviors:EventTrigger>
                                </Behaviors:Interaction.Triggers>
                                <ListBox.Resources>
                                    <Style BasedOn="{StaticResource MaterialDesignScrollViewer}" TargetType="ScrollViewer" />
                                    <Style BasedOn="{StaticResource MaterialDesignScrollBarMinimal}" TargetType="ScrollBar" />
                                    <DataTemplate DataType="{x:Type viewModel:MenuItem}">
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource MaterialDesign3.NavigationDrawerPrimaryListBoxItem}" TargetType="ListBoxItem">
                                        <Setter Property="Width" Value="240" />
                                        <Setter Property="Height" Value="40" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="Visibility" Value="{Binding Visible}" />
                                        <Setter Property="materialDesign:NavigationDrawerAssist.SelectedIcon" Value="{Binding SelectedIcon}" />
                                        <Setter Property="materialDesign:NavigationDrawerAssist.UnselectedIcon" Value="{Binding UnselectedIcon}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </materialDesign:DrawerHost.LeftDrawerContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="80" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <materialDesign:ColorZone
                            Height="80"
                            materialDesign:ElevationAssist.Elevation="Dp0"
                            DockPanel.Dock="Top"
                            Mode="Standard">
                            <DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="184" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton
                                        x:Name="MenuToggleButton"
                                        Grid.Column="0"
                                        Margin="6,0,0,0"
                                        IsChecked="{Binding MenuOpened, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignHamburgerToggleButton}" />

                                    <TextBlock
                                        Name="TxtViceTitle"
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="大秦数能-EMS" />
                                    <Border
                                        Grid.Column="3"
                                        Margin="0,0,28,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                                        BorderThickness="1"
                                        CornerRadius="20">
                                        <StackPanel Orientation="Vertical">
                                            <ComboBox
                                                Name="CbLanguage"
                                                Width="134"
                                                Height="32"
                                                DisplayMemberPath="Display"
                                                ItemsSource="{Binding LangItems, Source={x:Static lang:MultiLang.Instance}}"
                                                SelectedItem="{Binding SelectedLang, Source={x:Static lang:MultiLang.Instance}}">
                                                <Behaviors:Interaction.Triggers>
                                                    <Behaviors:EventTrigger EventName="SelectionChanged">
                                                        <Behaviors:InvokeCommandAction Command="{Binding SwitchLanguageCommand}" />
                                                    </Behaviors:EventTrigger>
                                                </Behaviors:Interaction.Triggers>
                                            </ComboBox>
                                            <Grid
                                                Width="134"
                                                Margin="0,5,0,0"
                                                HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="25*" />
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="25*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding 亮, Source={x:Static lang:MultiLang.Instance}}" />
                                                <ToggleButton
                                                    x:Name="DarkModeToggleButton"
                                                    Grid.Column="1"
                                                    Click="MenuDarkModeButton_Click"
                                                    IsChecked="True"
                                                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding 暗, Source={x:Static lang:MultiLang.Instance}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Button
                                        Name="BtnLink"
                                        Grid.Column="4"
                                        Height="72"
                                        materialDesign:ButtonAssist.CornerRadius="20"
                                        BorderBrush="{Binding Online, Source={x:Static ui:UiGlobalContext.Instance}, Converter={x:Static convt:BooleanToBrushConverter.LightGreen}}"
                                        Command="{Binding ConnectAllCommand, IsAsync=True}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                            <!--<TextBox
                                                Width="30"
                                                Padding="5,5,2,5"
                                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                Text="{Binding MainSlaveId, Source={x:Static ui:UiGlobalContext.Instance}}" />-->
                                            <materialDesign:PackIcon
                                                Width="30"
                                                Height="30"
                                                HorizontalAlignment="Center"
                                                Foreground="{Binding Online, Source={x:Static ui:UiGlobalContext.Instance}, Converter={x:Static convert:BooleanToBrushConverter.LightGreen}, FallbackValue=DimGray}"
                                                Kind="Link" />
                                        </StackPanel>
                                    </Button>
                                    <materialDesign:PopupBox
                                        Grid.Column="5"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Center"
                                        PlacementMode="BottomAndAlignCentres"
                                        Style="{StaticResource MaterialDesignMultiFloatingActionPopupBox}">
                                        <materialDesign:PopupBox.ToggleCheckedContent>
                                            <materialDesign:PackIcon
                                                Width="24"
                                                Height="24"
                                                Kind="Head" />
                                        </materialDesign:PopupBox.ToggleCheckedContent>
                                        <materialDesign:PopupBox.ToggleContent>
                                            <materialDesign:PackIcon
                                                Width="24"
                                                Height="24"
                                                Kind="Head" />
                                        </materialDesign:PopupBox.ToggleContent>
                                        <ListView materialDesign:ListBoxItemAssist.ShowSelection="False" Background="{StaticResource MaterialDesign.Brush.Primary}">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Width" Value="120" />
                                                    <Setter Property="Height" Value="32" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListViewItem>
                                                <Button
                                                    Name="BtnLogout"
                                                    Width="120"
                                                    Click="BtnLogout_Click"
                                                    Content="{Binding 退出登录, Source={x:Static lang:MultiLang.Instance}}"
                                                    Style="{StaticResource MaterialDesignFlatLightButton}" />

                                            </ListViewItem>
                                            <ListViewItem>
                                                <Button
                                                    Name="BtnPriviledge"
                                                    Width="120"
                                                    Command="{Binding PriviledgeCommand, IsAsync=True}"
                                                    Content="权限测试"
                                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                            </ListViewItem>
                                        </ListView>
                                    </materialDesign:PopupBox>
                                </Grid>
                            </DockPanel>
                        </materialDesign:ColorZone>
                        <Rectangle
                            Grid.Row="1"
                            Margin="16,0,16,0"
                            Fill="DarkGray" />
                        <ContentControl
                            Grid.Row="2"
                            Margin="16"
                            Content="{Binding SelectedMenu.Content, UpdateSourceTrigger=PropertyChanged, FallbackValue={x:Null}}" />

                    </Grid>
                </materialDesign:DrawerHost>
            </materialDesign:DialogHost>
            <materialDesign:Snackbar
                Name="MainSnackbar"
                Grid.Row="1"
                VerticalAlignment="Bottom"
                MessageQueue="{materialDesign:MessageQueue}" />
        </Grid>
    </Border>
</Window>
