<UserControl
    x:Class="org.Product01.Views.FaultLogsOfSummaryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:convert="clr-namespace:org.Ui.Converters;assembly=org.Ui"
    xmlns:convt="clr-namespace:org.Ui.Converters;assembly=org.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Product01.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="clr-namespace:org.Ui.Selectors;assembly=org.Ui"
    xmlns:viewModels="clr-namespace:org.Product01.ViewModels"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/org.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <WrapPanel
            Grid.Row="0"
            Margin="0,0,0,10"
            IsHitTestVisible="False"
            Orientation="Horizontal">
            <materialDesign:Card Width="240" Margin="10,10,0,0">
                <StackPanel Orientation="Vertical">
                    <DockPanel
                        Height="40"
                        Margin="5,0,5,0"
                        HorizontalAlignment="Stretch">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{Binding 设备状态_EMS与BMS通讯, Source={x:Static lang:MultiLang.Instance}, FallbackValue=EMS与BMS通讯}" />
                        <ToggleButton
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                            ToolTip="MaterialDesignSwitchToggleButton with Custom Track Background">
                            <materialDesign:ToggleButtonAssist.SwitchTrackOnBackground>
                                <SolidColorBrush Color="Red" />
                            </materialDesign:ToggleButtonAssist.SwitchTrackOnBackground>
                            <materialDesign:ToggleButtonAssist.SwitchTrackOffBackground>
                                <SolidColorBrush Color="Green" />
                            </materialDesign:ToggleButtonAssist.SwitchTrackOffBackground>
                        </ToggleButton>
                    </DockPanel>
                </StackPanel>
            </materialDesign:Card>
        </WrapPanel>
    </ScrollViewer>
</UserControl>
