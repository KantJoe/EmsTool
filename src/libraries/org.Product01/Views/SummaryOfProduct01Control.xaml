<UserControl
    x:Class="org.Product01.Views.SummaryOfProduct01Control"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:convt="clr-namespace:org.Ui.Converters;assembly=org.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Product01.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="clr-namespace:org.Ui.Selectors;assembly=org.Ui"
    xmlns:viewModels="clr-namespace:org.Product01.ViewModels"
    d:DesignHeight="758"
    d:DesignWidth="1248"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/org.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="10,10,10,10"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp12"
            Orientation="Horizontal">
            <TextBlock
                Width="120"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="{Binding 指定EMS, Source={x:Static lang:MultiLang.Instance}, FallbackValue=指定EMS}" />
            <ComboBox
                Width="180"
                ItemsSource="{Binding Links}"
                SelectedItem="{Binding SelectedLink}">
                <Behaviors:Interaction.Triggers>
                    <Behaviors:EventTrigger EventName="SelectionChanged">
                        <Behaviors:InvokeCommandAction Command="{Binding SelectLinkChangedCommand}" />
                    </Behaviors:EventTrigger>
                </Behaviors:Interaction.Triggers>
            </ComboBox>
        </StackPanel>
        <TabControl
            Grid.Row="1"
            HorizontalContentAlignment="Left"
            Style="{StaticResource MaterialDesignFilledTabControl}">
            <TabItem Header="{Binding 设备状态_状态概览, Source={x:Static lang:MultiLang.Instance}, FallbackValue=状态概览}">
                <local:DeviceSummaryControl DataContext="{Binding}" />
            </TabItem>
            <TabItem Header="{Binding 设备状态_故障概览, Source={x:Static lang:MultiLang.Instance}, FallbackValue=故障概览}">
                <local:FaultLogsOfSummaryControl DataContext="{Binding}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
