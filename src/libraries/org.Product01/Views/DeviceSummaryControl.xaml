            <materialDesign:Card
                Width="340"
                Height="350"
                Margin="0,10,10,0"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
                <StackPanel
                    Margin="5,10,5,10"
                    VerticalAlignment="Top"
                    Orientation="Vertical">
                    <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <TextBlock
