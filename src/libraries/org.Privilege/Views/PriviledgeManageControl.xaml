<UserControl
    x:Class="org.Privilege.Views.PriviledgeManageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:global="clr-namespace:org.Utils.Global;assembly=org.Utils"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Privilege.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="758"
    d:DesignWidth="1056"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <TabControl
        HorizontalContentAlignment="Left"
        Style="{StaticResource MaterialDesignFilledUniformTabControl}"
        VirtualizingPanel.CacheLength="1"
        VirtualizingPanel.CacheLengthUnit="Item"
        VirtualizingPanel.IsContainerVirtualizable="True"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.ScrollUnit="Item"
        VirtualizingPanel.VirtualizationMode="Recycling">
        <TabItem Header="{Binding 权限控制_角色列表, Source={x:Static lang:MultiLang.Instance}}">
            <TabItem.Visibility>
                <Binding
                    Converter="{StaticResource PriviledgeConvert}"
                    ConverterParameter="{x:Static global:ApplicationPriviledge.PriviledgeManage_Role_List}"
                    Path="PriviledgeManage_Role_List"
                    Source="{x:Static global:LoginAccountContext.AggregatePriviledges}" />
            </TabItem.Visibility>
            <StackPanel Orientation="Vertical">
                <Grid Height="40" Margin="30,15,30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="80"
                            Command="{Binding AppendRoleCommand}"
                            Content="{Binding 新增, Source={x:Static lang:MultiLang.Instance}}" />
                    </StackPanel>
                </Grid>
                <ListView
                    ItemsSource="{Binding ApplicationRoles}"
                    SelectedItem="{Binding SelectedRole}"
                    VirtualizingPanel.CacheLength="20"
                    VirtualizingPanel.CacheLengthUnit="Item"
                    VirtualizingPanel.IsContainerVirtualizable="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Item"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn DisplayMemberBinding="{Binding Name}" Header="Name" />
                            <GridViewColumn Header="Options">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding DataContext.RemoveRoleCommand, IsAsync=True, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding 删除, Source={x:Static lang:MultiLang.Instance}}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </TabItem>
        <TabItem Header="{Binding 权限控制_账户列表, Source={x:Static lang:MultiLang.Instance}}">
            <TabItem.Visibility>
                <Binding
                    Converter="{StaticResource PriviledgeConvert}"
                    ConverterParameter="{x:Static global:ApplicationPriviledge.PriviledgeManage_Account_List}"
                    Path="PriviledgeManage_Account_List"
                    Source="{x:Static global:LoginAccountContext.AggregatePriviledges}" />
            </TabItem.Visibility>
            <StackPanel Orientation="Vertical">
                <Grid Height="40" Margin="30,15,30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="80"
                            Command="{Binding AppendAccountCommand}"
                            Content="{Binding 新增, Source={x:Static lang:MultiLang.Instance}}" />
                    </StackPanel>
                </Grid>
                <ListView
                    ItemsSource="{Binding LoginAccounts}"
                    SelectedItem="{Binding SelectedAccount}"
                    VirtualizingPanel.CacheLength="20"
                    VirtualizingPanel.CacheLengthUnit="Item"
                    VirtualizingPanel.IsContainerVirtualizable="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Item"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn DisplayMemberBinding="{Binding Account}" Header="Account" />
                            <GridViewColumn DisplayMemberBinding="{Binding Name}" Header="Name" />
                            <GridViewColumn Width="200" Header="Roles">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Roles}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="320" Header="Options">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                Margin="0,0,10,0"
                                                Command="{Binding DataContext.RemoveAccountCommand, IsAsync=True, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding 删除, Source={x:Static lang:MultiLang.Instance}}"
                                                Style="{StaticResource MaterialDesignRaisedButton}" />
                                            <Button
                                                Margin="10,0,0,0"
                                                Command="{Binding DataContext.EditAccountCommand, IsAsync=True, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding 编辑, Source={x:Static lang:MultiLang.Instance}}"
                                                Style="{StaticResource MaterialDesignRaisedButton}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </TabItem>
        <TabItem Header="{Binding 权限控制_权限列表, Source={x:Static lang:MultiLang.Instance}}">
            <TabItem.Visibility>
                <Binding
                    Converter="{StaticResource PriviledgeConvert}"
                    ConverterParameter="{x:Static global:ApplicationPriviledge.PriviledgeManage_Resource_List}"
                    Path="PriviledgeManage_Resource_List"
                    Source="{x:Static global:LoginAccountContext.AggregatePriviledges}" />
            </TabItem.Visibility>
            <StackPanel Orientation="Vertical">
                <Grid Height="40" Margin="30,15,30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">

                        <TextBlock
                            Margin="0,0,15,0"
                            VerticalAlignment="Center"
                            Text="{Binding 权限控制_角色项, Source={x:Static lang:MultiLang.Instance}}" />
                        <ComboBox
                            Width="120"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Resource_ApplicationRoles}"
                            SelectedItem="{Binding Resource_SelectedRole}"
                            Style="{StaticResource MaterialDesignFilledComboBox}">
                            <Behaviors:Interaction.Triggers>
                                <Behaviors:EventTrigger EventName="SelectionChanged">
                                    <Behaviors:InvokeCommandAction Command="{Binding Resource_SelectedRoleChangedCommand}" />
                                </Behaviors:EventTrigger>
                            </Behaviors:Interaction.Triggers>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <ListView
                    ItemsSource="{Binding ApplicationResources}"
                    SelectedItem="{Binding SelectedResource}"
                    VirtualizingPanel.CacheLength="20"
                    VirtualizingPanel.CacheLengthUnit="Item"
                    VirtualizingPanel.IsContainerVirtualizable="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Item"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn
                                Width="320"
                                DisplayMemberBinding="{Binding Name}"
                                Header="Name" />
                            <GridViewColumn DisplayMemberBinding="{Binding PriviledgeLevel}" Header="PriviledgeLevel" />
                            <GridViewColumn Header="Options">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="10,0,0,0"
                                            Command="{Binding DataContext.EditPriviledgeCommand, IsAsync=True, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding 编辑, Source={x:Static lang:MultiLang.Instance}}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </TabItem>
    </TabControl>
</UserControl>
