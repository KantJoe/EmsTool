<UserControl
    x:Class="org.Privilege.Views.AppendRoleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:org.Ui.MultiLanguage;assembly=org.Ui"
    xmlns:local="clr-namespace:org.Privilege.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:valid="clr-namespace:org.Ui.ValidationRules;assembly=org.Ui"
    Width="210"
    Height="210"
    TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">
    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock
                    Name="TbTitle"
                    Grid.Column="1"
                    Width="130"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="LightGray"
                    Style="{StaticResource MaterialDesignTitleMediumTextBlock}"
                    Text="{Binding 权限控制_新增角色, Source={x:Static lang:MultiLang.Instance}}"
                    TextWrapping="NoWrap" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <TextBlock
                    Height="30"
                    Margin="10,5,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding 名称, Source={x:Static lang:MultiLang.Instance}}" />
                <TextBox
                    Name="TxtName"
                    Height="30"
                    Margin="40,5,10,0"
                    VerticalAlignment="Center"
                    materialDesign:ValidationAssist.HorizontalAlignment="Left">
                    <TextBox.Text>
                        <Binding Path="Name" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <valid:LengthValidRule MinLength="6" ValidatesOnTargetUpdated="True" />
                                <valid:OnlyAlphabetAndNumbersValidRule ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </StackPanel>
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Name="BtnConfirm"
                    Width="90"
                    Margin="0,0,5,0"
                    Click="BtnConfirm_Click"
                    Content="{Binding 确定, Source={x:Static lang:MultiLang.Instance}}" />
                <Button
                    Name="BtnCancel"
                    Width="90"
                    Margin="5,0,0,0"
                    Click="BtnCancel_Click"
                    Content="{Binding 取消, Source={x:Static lang:MultiLang.Instance}}"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>
